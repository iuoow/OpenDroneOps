# Copy to deployment/release.env outside source control and replace every value.
APP_ENV=production
# Full host IP and host port. Expose through a reverse proxy when needed.
SERVER_BIND=127.0.0.1:8080
HTTP_ADDR=:8080
ADMIN_ADDR=127.0.0.1:9090
POSTGRES_DSN=postgres://opendroneops:CHANGE_ME@postgres.example:5432/opendroneops?sslmode=verify-full
REDIS_ADDR=redis.example:6379
REDIS_PASSWORD=CHANGE_ME
MQTT_URL=mqtts://mqtt.example:8883
MQTT_CLIENT_ID=opendroneops-worker-production
MQTT_USERNAME=opendroneops
MQTT_PASSWORD=CHANGE_ME
MQTT_SESSION_EXPIRY_SECONDS=3600
MQTT_KEEP_ALIVE_SECONDS=30
RAW_MESSAGE_RETENTION_DAYS=7
WS_SEND_QUEUE_SIZE=256
WS_MAX_SESSIONS_PER_WORKSPACE=64
WS_MAX_DEVICE_FILTERS=100
WS_EVENT_DEDUPE_CAPACITY=2048
MQTT_SHARD_COUNT=32
MQTT_SHARD_QUEUE_SIZE=1024
MQTT_MAX_PENDING_PER_KEY=64
REALTIME_NODE_ID=REPLACE_WITH_UNIQUE_INSTANCE_ID
REALTIME_CHANNEL=opendroneops:realtime:v1
REALTIME_DEDUPE_CAPACITY=4096
