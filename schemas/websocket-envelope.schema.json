{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebSocket server event",
  "type": "object",
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {}
  },
  "additionalProperties": false
}
